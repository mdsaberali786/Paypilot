# Database (Neon)
# Copy the pooled connection string from Neon Console > Paypilot > Connect,
# then save it only in a local .env file. Keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# AI Provider (Gemini)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# Razorpay Test Mode (server-side secrets; never expose or commit real values)
RAZORPAY_KEY_ID="your-razorpay-test-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Application
NODE_ENV="development"
